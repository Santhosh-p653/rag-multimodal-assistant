# --- LLM Providers ---
# Ollama (primary, local) — leave OLLAMA_BASE_URL as-is unless running 
# Ollama on a different host/port
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true
OLLAMA_MODEL_CLASSIFICATION=qwen2.5:3b
OLLAMA_MODEL_CHAT=gemma3:4b
OLLAMA_MODEL_WORKFLOW=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=180

# Cloud fallback (used automatically if Ollama is unreachable)
GROQ_API_KEY=your_groq_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# --- Speech & Transcription (STT/TTS) ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Vector Database ---
QDRANT_COLLECTION=manuals

# --- App Settings ---
# UPLOAD_DIR=data_sandbox/input_manuals
# OUTPUT_DIR=data_sandbox/processed_markdown
